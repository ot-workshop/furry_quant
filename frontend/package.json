{
  "name": "finance-quant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.0",
    "dayjs": "1.11.23",
    "echarts": "5.6.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
